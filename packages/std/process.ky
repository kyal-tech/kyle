@link "c"
extern fn ky_getenv(ptr, ptr) i32
extern fn ky_setenv(ptr, ptr) i32
extern fn ky_init_args(i32, ptr) i64

final class Process:
    static fn getenv(name: &str) str:
        buf = ky_alloc(4096)
        len = ky_getenv(name as ptr, buf)
        if len <= 0: return ""
        buf as str

    static fn setenv(name: &str, val: &str) bool:
        ky_setenv(name as ptr, val as ptr) == 1

    static fn init_args(argc: i32, argv: ptr) i64:
        ky_init_args(argc, argv)
