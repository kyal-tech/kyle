@link "c"

extern fn ky_bytes_new(i32) ptr
extern fn ky_bytes_get(ptr, i32) i32
extern fn ky_bytes_set(ptr, i32, i32)
extern fn ky_bytes_free(ptr, i32)
extern fn ky_bytes_to_hex(ptr, i32) ptr
extern fn ky_bytes_from_hex(ptr, ptr) ptr
extern fn ky_bytes_to_base64(ptr, i32) ptr
extern fn ky_bytes_from_base64(ptr, ptr) ptr
extern fn ky_bytes_to_be_i32(i32) ptr
extern fn ky_bytes_to_le_i32(i32) ptr
extern fn ky_bytes_to_be_i64(i64) ptr
extern fn ky_bytes_to_le_i64(i64) ptr
extern fn ky_bytes_from_be_i32(ptr) i32
extern fn ky_bytes_from_le_i32(ptr) i32
extern fn ky_bytes_from_be_i64(ptr) i64
extern fn ky_bytes_from_le_i64(ptr) i64
extern fn ky_bytes_from_be_i32_at(ptr, i32) i32
extern fn ky_bytes_from_be_i64_at(ptr, i32) i64
extern fn ky_buffer_new(i32) i64
extern fn ky_buffer_free(i64)
extern fn ky_buffer_len(i64) i32
extern fn ky_buffer_write_byte(i64, i32)
extern fn ky_buffer_write_be_i32(i64, i32)
extern fn ky_buffer_write_le_i32(i64, i32)
extern fn ky_buffer_write_be_i64(i64, i64)
extern fn ky_buffer_write_le_i64(i64, i64)
extern fn ky_buffer_write_str(i64, ptr)
extern fn ky_buffer_to_bytes(i64, ptr) ptr
extern fn ky_buffer_clear(i64)

fn new(n: i32) i64:
    ky_bytes_new(n) as i64

fn byte_at(b: i64, i: i32) i32:
    ky_bytes_get(b as ptr, i)

fn set_byte(b: i64, i: i32, v: i32):
    ky_bytes_set(b as ptr, i, v)

fn bytes_free(b: i64, size: i32):
    ky_bytes_free(b as ptr, size)

fn to_hex(b: i64, size: i32) str:
    raw = ky_bytes_to_hex(b as ptr, size) as i64
    if raw == 0: return ""
    (raw as ptr) as str

fn to_base64(b: i64, size: i32) str:
    raw = ky_bytes_to_base64(b as ptr, size) as i64
    if raw == 0: return ""
    (raw as ptr) as str

fn from_hex(s: &str) i64:
    out_size: ^i32 = 0
    ky_bytes_from_hex(s as ptr, &out_size as ptr) as i64

fn from_base64(s: &str) i64:
    out_size: ^i32 = 0
    ky_bytes_from_base64(s as ptr, &out_size as ptr) as i64

fn to_be_i32(val: i32) i64:
    ky_bytes_to_be_i32(val) as i64

fn to_le_i32(val: i32) i64:
    ky_bytes_to_le_i32(val) as i64

fn to_be_i64(val: i64) i64:
    ky_bytes_to_be_i64(val) as i64

fn to_le_i64(val: i64) i64:
    ky_bytes_to_le_i64(val) as i64

fn from_be_i32(b: i64) i32:
    ky_bytes_from_be_i32(b as ptr)

fn from_le_i32(b: i64) i32:
    ky_bytes_from_le_i32(b as ptr)

fn from_be_i64(b: i64) i64:
    ky_bytes_from_be_i64(b as ptr)

fn from_le_i64(b: i64) i64:
    ky_bytes_from_le_i64(b as ptr)

fn from_be_i32_at(b: i64, offset: i32) i32:
    ky_bytes_from_be_i32_at(b as ptr, offset)

fn from_be_i64_at(b: i64, offset: i32) i64:
    ky_bytes_from_be_i64_at(b as ptr, offset)

final class Buffer:
    handle: ^i64

    static fn new(capacity: i32) Buffer:
        Buffer{handle: ky_buffer_new(capacity)}

    fn free(this):
        if this.handle != 0:
            ky_buffer_free(this.handle)
            this.handle = 0

    fn len(this) i32:
        ky_buffer_len(this.handle)

    fn write_byte(this, b: i32):
        ky_buffer_write_byte(this.handle, b)

    fn write_be_i32(this, val: i32):
        ky_buffer_write_be_i32(this.handle, val)

    fn write_le_i32(this, val: i32):
        ky_buffer_write_le_i32(this.handle, val)

    fn write_be_i64(this, val: i64):
        ky_buffer_write_be_i64(this.handle, val)

    fn write_le_i64(this, val: i64):
        ky_buffer_write_le_i64(this.handle, val)

    fn write_str(this, s: &str):
        ky_buffer_write_str(this.handle, s as ptr)

    fn to_bytes(this, out_size: ^i32) i64:
        ky_buffer_to_bytes(this.handle, &out_size as ptr) as i64

    fn clear(this):
        ky_buffer_clear(this.handle)
