# Test: Form with model (simplified, no imports)
<view>
    @(
        form: ^UserForm = UserForm()
        fn handle_submit():
            print("submitted")
    )

    <form model=@form submit=@handle_submit>
        <text_field field="name" label="Nombre" />
        <text_field field="email" label="Email" />
        <button text="Guardar" type="submit" />
    </form>
</view>
