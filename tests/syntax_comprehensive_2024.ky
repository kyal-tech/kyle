# 14. Modules (import via use)
# ═══════════════════════════════════════════════════════════

use my.{hello}

fn test_modules():
    msg = hello("test")
    assert(msg == "hello test")
    print("15.mod ok")

# ═══════════════════════════════════════════════════════════
# MAIN — run all tests
# ═══════════════════════════════════════════════════════════

fn main():
    test_variables()
    test_primitives()
    test_compound()
    test_functions()
    test_control_flow()
    test_match()
    test_classes()
    test_errors()
    test_strings()
    test_generics()
    test_operators()
    test_ffi()
    test_modules()
    print("=== ALL TESTS PASSED ===")
