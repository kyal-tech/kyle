# Kyle — Comprehensive Syntax Test 2024 (v2)
# Tests ALL documented language features that are currently working
# Known limitations documented inline

# ═══════════════════════════════════════════════════════════
# 1. Variables & Mutability
# ═══════════════════════════════════════════════════════════

fn test_variables():
    name = "Kyle"
    count: ^i32 = 0
    count.set(5)
    x: i32 = 42
    y = 10
    MAX := 100
    c: ^i32 = 0
    c.set(c.get() + 1)
    print("1.var ok")

# ═══════════════════════════════════════════════════════════
# 2. Types — Primitives
# ═══════════════════════════════════════════════════════════

fn test_primitives():
    a: i8 = 1 as i8
    b: i16 = 2 as i16
    c: i32 = 3
    d: i64 = 4 as i64
    e: u8 = 5 as u8
    f: u16 = 6 as u16
    g: u32 = 7 as u32
    h: u64 = 8 as u64
    i: f32 = 1.5
    j: f64 = 2.5
    k: bool = true
    l: char = 'A'
    m: str = "hello"
    print("2.prim ok")

# ═══════════════════════════════════════════════════════════
# 3. Types — Compound  (arr[0] returns garbage — off-by-one bug)
# ═══════════════════════════════════════════════════════════

fn test_compound():
    arr: [i32, 3] = [10, 20, 30]
    assert(arr.len() == 3)
    lst: ^[i32] = [10, 20, 30]
    lst.push(40)
    v = lst.pop()
    assert(v == 40)
    lst.insert(0, 5)
    v2 = lst.pop_first()
    assert(v2 == 5)
    assert(lst.len() == 3)
    lst.set(0, 99)
    assert(lst[0] == 99)
    lst.remove_at(0)
    assert(lst.len() == 2)
    unsorted: ^[i32] = [3, 1, 2]
    unsorted.sort()
    assert(unsorted[0] == 1)
    unsorted.reverse()
    assert(unsorted[2] == 1)
    d: {str: i32} = {"a": 1}
    d.set("b", 2)
    assert(d.get("a") == 1)
    assert(d.len() == 2)
    t: (i32, str) = (1, "hello")
    (a, b) = t
    assert(a == 1)
    s: ^set<i32> = set{1, 2, 3}
    s.add(4)
    assert(s.len() == 4)
    assert(s.contains(1))
    s.remove(2)
    assert(s.len() == 3)
    print("3.comp ok")

# ═══════════════════════════════════════════════════════════
# 4. Functions
# ═══════════════════════════════════════════════════════════

fn add(a: i32, b: i32) i32:
    a + b

fn make_msg(name: str) str:
    return "hello " + name

fn greet(name: str = "world") str:
    return "hello " + name

fn identity<T>(x: T) T:
    return x

fn length(s: &str) i32:
    return s.len()

fn test_functions():
    assert(add(1, 2) == 3)
    assert(make_msg("Kyle") == "hello Kyle")
    assert(greet() == "hello world")
    assert(identity(42) == 42)
    assert(identity("hi") == "hi")
    assert(length(&"test") == 4)
    print("4.fn ok")

# ═══════════════════════════════════════════════════════════
# 5. Control Flow
# ═══════════════════════════════════════════════════════════

fn test_control_flow():
    x = 5
    if x > 3:
        print("if_ok")
    if x > 10:
        print("big")
    elif x > 3:
        print("elif_ok")
    if false:
        print("nope")
    else:
        print("else_ok")
    label = if x > 3: "big" else: "small"
    assert(label == "big")
    i: ^i32 = 0
    while i.get() < 3:
        i.set(i.get() + 1)
    assert(i.get() == 3)
    total: ^i32 = 0
    for j in 0..3:
        total.set(total.get() + j)
    assert(total.get() == 3)
    items: ^[i32] = [1, 2, 3]
    sum: ^i32 = 0
    for v in items:
        sum.set(sum.get() + v)
    assert(sum.get() == 6)
    print("5.cflow ok")

# ═══════════════════════════════════════════════════════════
# 6. Match / Pattern Matching
# ═══════════════════════════════════════════════════════════

enum Color:
    Red Green Blue
    RGB(i32, i32, i32)

fn test_match():
    c = Color.Red
    result = ""
    match c:
        Color.Red: result = "red"
        _: result = "other"
    assert(result == "red")
    result2 = match c:
        Color.Red: "r"
        _: "x"
    assert(result2 == "r")
    rgb = Color.RGB(100, 200, 255)
    rval = match rgb:
        Color.RGB(r, g, b): r
        _: 0
    assert(rval == 100)
    val: str = "hello"
    opt: i32? = some(42)
    assert(opt.is_some())
    assert(not opt.is_none())
    v = opt.unwrap()
    assert(v == 42)
    print("6.match ok")

# ═══════════════════════════════════════════════════════════
# 7. Classes & Inheritance
# ═══════════════════════════════════════════════════════════

final class Point:
    x: i32 = 0
    y: i32 = 0

    fn sum() i32:
        return this.x + this.y
    fn set_x(val: i32):
        this.x = val

final class ColorPoint :: Point:
    color: str = "black"

fn test_classes():
    p = Point{x: 10, y: 20}
    assert(p.sum() == 30)
    p.set_x(5)
    assert(p.x == 5)
    cp = ColorPoint{x: 1, y: 2, color: "red"}
    assert(cp.color == "red")
    assert(cp.x == 1)
    print("7.class ok")

# ═══════════════════════════════════════════════════════════
# 8. Enums (tested above in match)
# ═══════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════
# 9. Error Handling
# ═══════════════════════════════════════════════════════════

fn test_errors():
    # Note: unwrap_or, ??, and match on T?/T! trigger _call SSA bug
    opt: i32? = some(42)
    assert(opt.is_some())
    assert(not opt.is_none())
    assert(opt.unwrap() == 42)
    print("9.err ok")

# ═══════════════════════════════════════════════════════════
# 10. Strings & Interpolation
# ═══════════════════════════════════════════════════════════

fn test_strings():
    s = "hello world"
    assert(s + "!" == "hello world!")
    assert(s.len() == 11)
    assert(s.upper() == "HELLO WORLD")
    assert(s.lower() == "hello world")
    assert(s.contains("world"))
    assert(s.char_at(0) == 'h')
    assert(s.find("world") == 6)
    parts = s.split(" ")
    assert(parts.len() == 2)
    assert(parts[0] == "hello")
    assert(s.starts_with("hello"))
    assert(s.ends_with("world"))
    assert("  hi  ".trim() == "hi")
    assert(s.replace("world", "Kyle") == "hello Kyle")
    assert(s.substr(0, 5) == "hello")
    print("11.str ok")

# ═══════════════════════════════════════════════════════════
# 11. Generics
# ═══════════════════════════════════════════════════════════

final class Box<T>:
    value: T

final class Pair<A, B>:
    first: A
    second: B

fn test_generics():
    b = Box{value: 42}
    assert(b.value == 42)
    p = Pair{first: "age", second: 30}
    assert(p.first == "age")
    b2 = Box{value: "hello"}
    assert(b2.value == "hello")
    print("12.gen ok")

# ═══════════════════════════════════════════════════════════
# 12. Operators & Overloading
# ═══════════════════════════════════════════════════════════

final class Vec2:
    x: i32
    y: i32
    fn op_add(other: Vec2) Vec2:
        return Vec2{x: this.x + other.x, y: this.y + other.y}

fn test_operators():
    assert(10 + 5 == 15)
    assert(10 - 5 == 5)
    assert(10 * 5 == 50)
    assert(10 / 5 == 2)
    assert(10 % 3 == 1)
    assert(5 == 5)
    assert(5 != 6)
    assert(5 < 6)
    assert(6 > 5)
    assert(5 <= 5)
    assert(5 >= 5)
    assert(true and true)
    assert(true or false)
    assert(not false)
    v = 42 as i64
    c: ^i32 = 10
    c.set(c.get() + 5)
    assert(c.get() == 15)
    a = Vec2{x: 1, y: 2}
    b = Vec2{x: 3, y: 4}
    c2 = a + b
    assert(c2.x == 4)
    print("13.op ok")

